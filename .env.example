# Application Settings
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000
JWT_SECRET=your-secure-jwt-secret
SESSION_SECRET=your-secure-session-secret

# Email Configuration
EMAIL_FROM=noreply@eaglevisionedge.com
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-email-password

# DocuSign Configuration
DOCUSIGN_ENABLED=true
DOCUSIGN_INTEGRATION_KEY=your-integration-key
DOCUSIGN_USER_ID=your-user-id
DOCUSIGN_ACCOUNT_ID=your-account-id
DOCUSIGN_API_BASE_URL=https://demo.docusign.net/restapi
DOCUSIGN_AUTH_SERVER=account-d.docusign.com
DOCUSIGN_WEBHOOK_SECRET=your-webhook-secret
DOCUSIGN_WEBHOOK_URL=${API_URL}/api/webhooks/docusign

# Note: For production, the following should be set in Netlify's environment variables:
# - FIREBASE_SERVICE_ACCOUNT (as a JSON string)
# - DOCUSIGN_PRIVATE_KEY (as a multi-line string)

# Cookie Settings
COOKIE_DOMAIN=localhost
SECURE_COOKIE=false
